	column 'Faixa Precipitação' =
			
			VAR Chuva =
			    fato_municipio_dia[Dados.precipitacao_dia_mm]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(Chuva), "Sem dados",
			        Chuva = 0, "Sem chuva",
			        Chuva <= 5, "0,1 a 5 mm",
			        Chuva <= 20, "5,1 a 20 mm",
			        Chuva <= 50, "20,1 a 50 mm",
			        "> 50 mm"
			    )
		lineageTag: b9ed9ea7-aec6-4978-86a9-499aadd40046
		summarizeBy: none
		sortByColumn: 'Faixa Precipitação Ordem'

