	column 'Faixa Radiação Ordem' =
			
			VAR Radiacao =
			    fato_municipio_dia[Dados.radiacao_global_dia_kj_m2]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(Radiacao), 99,
			        Radiacao <= 12350, 1,
			        Radiacao <= 16880, 2,
			        Radiacao <= 21560, 3,
