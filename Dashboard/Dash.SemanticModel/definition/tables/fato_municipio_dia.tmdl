	column 'Faixa Temperatura' =
			
			VAR Temperatura =
			    fato_municipio_dia[Dados.temperatura_media_dia_c]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(Temperatura), "Sem dado",
			        Temperatura < 15, "< 15 °C",
			        Temperatura < 20, "15–19,9 °C",
			        Temperatura < 25, "20–24,9 °C",
			        Temperatura < 30, "25–29,9 °C",
			        "≥ 30 °C"
			    )
		lineageTag: b0f965b7-1591-4df6-8dcd-ba4b9f01121c
		summarizeBy: none
		sortByColumn: 'Faixa Temperatura Ordem'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Ordem Faixa Temperatura' =
			
			VAR Temperatura =
			    fato_municipio_dia[Dados.temperatura_media_dia_c]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(Temperatura), 6,
			        Temperatura < 15, 1,
			        Temperatura < 20, 2,
			        Temperatura < 25, 3,
			        Temperatura < 30, 4,
			        5
			    )
		formatString: 0
		lineageTag: 786bb48a-b2b0-49b2-b54e-d14cec3d65c7
		summarizeBy: sum

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Faixa Temperatura Ordem' =
			
			VAR Temperatura =
			    fato_municipio_dia[Dados.temperatura_media_dia_c]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(Temperatura), 99,
			        Temperatura < 15, 1,
			        Temperatura < 20, 2,
			        Temperatura < 25, 3,
			        Temperatura < 30, 4,
			        5
