		formatString: 0
		lineageTag: 3e4f58f1-80f4-4286-b098-71de5234df67
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Faixa Umidade Ordem' =
			
			VAR Umidade =
			    fato_municipio_dia[Dados.umidade_media_dia_pct]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(Umidade), 99,
			        Umidade < 50, 1,
			        Umidade < 60, 2,
			        Umidade < 70, 3,
			        Umidade < 80, 4,
			        5
			    )
		formatString: 0
		lineageTag: 7cd6d818-27a1-42d0-a5bc-9a71b1c0954d
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Faixa Umidade' =
			
			VAR Umidade =
			    fato_municipio_dia[Dados.umidade_media_dia_pct]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(Umidade), "Sem dados",
			        Umidade < 50, "< 50%",
			        Umidade < 60, "50 a 59,9%",
			        Umidade < 70, "60 a 69,9%",
			        Umidade < 80, "70 a 79,9%",
			        ">= 80%"
			    )
		lineageTag: 0b818d85-06cf-4cc0-9984-a4b73e6bbff6
		summarizeBy: none
		sortByColumn: 'Faixa Umidade Ordem'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Faixa Precipitação Ordem' =
			
			VAR Chuva =
			    fato_municipio_dia[Dados.precipitacao_dia_mm]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(Chuva), 99,
			        Chuva = 0, 1,
			        Chuva <= 5, 2,
			        Chuva <= 20, 3,
			        Chuva <= 50, 4,
			        5
			    )
		formatString: 0
		lineageTag: d79ec679-afc4-455a-9aab-45309b07b120
		summarizeBy: sum

