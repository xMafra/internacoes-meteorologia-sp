	column 'Faixa Radiação' =
			
			VAR Radiacao =
			    fato_municipio_dia[Dados.radiacao_global_dia_kj_m2]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(Radiacao), "Sem dados",
			        Radiacao <= 12350, "Baixa",
			        Radiacao <= 16880, "Média-baixa",
			        Radiacao <= 21560, "Média-alta",
			        "Alta"
			    )
		lineageTag: 274b643a-7e79-47cb-8bb0-62072342f83e
		summarizeBy: none
		sortByColumn: 'Faixa Radiação Ordem'

		changedProperty = SortByColumn

