		displayFolder: 05 - CID
		lineageTag: 5f8d4f39-a41d-42e9-b641-80abae074a9a

	measure '% Municípios Positivos CID' =
			VAR Chave = [Chave CID em Escopo]
			RETURN DIVIDE(CALCULATE(MAX(analitico_cid_resumo[percentual_positivo]), analitico_cid_resumo[chave_alvo] = Chave), 100)
		formatString: 0.00%
		displayFolder: 05 - CID
		lineageTag: 17b3f8e0-1514-4036-b6b0-002259540f7c

	measure '% Municípios Negativos CID' =
