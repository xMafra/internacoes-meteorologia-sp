table analitico_cid_resumo
	lineageTag: 809c68d7-c04e-425c-b457-089b8c2d9e6d

	measure 'Chave CID em Escopo' =
			SWITCH(
				TRUE(),
				ISINSCOPE(dim_cid[descricao_categoria]), "CATEGORIA_" & SELECTEDVALUE(dim_cid[codigo_categoria]),
				ISINSCOPE(dim_cid[descricao_grupo]), "GRUPO_" & SELECTEDVALUE(dim_cid[codigo_grupo]),
				"CAPITULO_" & SELECTEDVALUE(dim_cid[codigo_capitulo])
			)
		displayFolder: 09 - Auxiliares
		lineageTag: 916174db-9070-48fe-be51-1c812daa64cf

	measure 'Mediana Contraste CID' =
			VAR Chave = [Chave CID em Escopo]
			RETURN CALCULATE(MAX(analitico_cid_resumo[mediana_diferenca_relativa]), analitico_cid_resumo[chave_alvo] = Chave)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 05 - CID
		lineageTag: 57d617ec-6f8d-484a-8a87-afc6198e3e57

	measure 'Q1 Contraste CID' =
			VAR Chave = [Chave CID em Escopo]
			RETURN CALCULATE(MAX(analitico_cid_resumo[q1]), analitico_cid_resumo[chave_alvo] = Chave)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 05 - CID
		lineageTag: 1a4c504f-0668-49f7-9bfb-e3045d491aad

	measure 'Q3 Contraste CID' =
			VAR Chave = [Chave CID em Escopo]
