	partition analitico_cid_resumo = m
		mode: import
		source =
				let
				    Fonte = Folder.Files("C:\Users\Guilherme\Desktop\TCC\data\consumption\dashboard_analytics\cid_resumo"),
				    Arquivos = Table.SelectRows(Fonte, each [Extension] = ".parquet"),
				    Dados = Table.AddColumn(Arquivos, "Tabela", each Parquet.Document([Content])),
				    Expandido = Table.ExpandTableColumn(Dados, "Tabela", {"chave_alvo","nivel_cid","ordem_nivel_cid","rotulo_alvo","municipios_validos","q1","mediana_diferenca_relativa","q3","percentual_positivo","percentual_negativo","internacoes_total","mediana_media_frio","mediana_media_quente"}),
				    Selecionado = Table.SelectColumns(Expandido,{"chave_alvo","nivel_cid","ordem_nivel_cid","rotulo_alvo","municipios_validos","q1","mediana_diferenca_relativa","q3","percentual_positivo","percentual_negativo","internacoes_total","mediana_media_frio","mediana_media_quente"}),
				    Tipos = Table.TransformColumnTypes(Selecionado,{{"chave_alvo", type text},{"nivel_cid", type text},{"ordem_nivel_cid", Int64.Type},{"rotulo_alvo", type text},{"municipios_validos", Int64.Type},{"q1", type number},{"mediana_diferenca_relativa", type number},{"q3", type number},{"percentual_positivo", type number},{"percentual_negativo", type number},{"internacoes_total", Int64.Type},{"mediana_media_frio", type number},{"mediana_media_quente", type number}})
				in Tipos

