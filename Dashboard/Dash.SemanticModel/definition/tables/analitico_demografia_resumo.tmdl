	partition analitico_demografia_resumo = m
		mode: import
		source =
				let
				    Fonte = Folder.Files("C:\Users\Guilherme\Desktop\TCC\data\consumption\dashboard_analytics\demografia_resumo"),
				    Arquivos = Table.SelectRows(Fonte, each [Extension] = ".parquet"),
				    Dados = Table.AddColumn(Arquivos, "Tabela", each Parquet.Document([Content])),
				    Expandido = Table.ExpandTableColumn(Dados, "Tabela", {"chave_alvo","faixa_etaria","ordem_faixa_etaria","sexo","sexo_descricao","ordem_sexo","municipios_validos","q1","mediana_diferenca_relativa","q3","percentual_positivo","percentual_negativo","internacoes_total"}),
				    Selecionado = Table.SelectColumns(Expandido,{"chave_alvo","faixa_etaria","ordem_faixa_etaria","sexo","sexo_descricao","ordem_sexo","municipios_validos","q1","mediana_diferenca_relativa","q3","percentual_positivo","percentual_negativo","internacoes_total"}),
				    Tipos = Table.TransformColumnTypes(Selecionado,{{"chave_alvo", type text},{"faixa_etaria", type text},{"ordem_faixa_etaria", Int64.Type},{"sexo", type text},{"sexo_descricao", type text},{"ordem_sexo", Int64.Type},{"municipios_validos", Int64.Type},{"q1", type number},{"mediana_diferenca_relativa", type number},{"q3", type number},{"percentual_positivo", type number},{"percentual_negativo", type number},{"internacoes_total", Int64.Type}})
				in Tipos

