table analitico_demografia_resumo
	lineageTag: 6dd26812-333d-4fd7-9ede-6fd01099209d

	measure 'Chave CID Selecionada' =
			VAR Categoria = SELECTEDVALUE(dim_cid[codigo_categoria])
			VAR Grupo = SELECTEDVALUE(dim_cid[codigo_grupo])
			VAR Capitulo = SELECTEDVALUE(dim_cid[codigo_capitulo])
			RETURN SWITCH(TRUE(), NOT ISBLANK(Categoria), "CATEGORIA_" & Categoria, NOT ISBLANK(Grupo), "GRUPO_" & Grupo, NOT ISBLANK(Capitulo), "CAPITULO_" & Capitulo, "TOTAL")
		displayFolder: 09 - Auxiliares
		lineageTag: 32e98cbb-94b6-454c-b2fb-e0147ec0676f

	measure 'Mediana Contraste Demográfico' =
			VAR Chave = [Chave CID Selecionada]
			RETURN CALCULATE(MAX(analitico_demografia_resumo[mediana_diferenca_relativa]), analitico_demografia_resumo[chave_alvo] = Chave)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 06 - Demografia
		lineageTag: 3d9e19e5-2b67-41bc-87eb-fdc8d5b7d95e

	measure 'Q1 Contraste Demográfico' =
			VAR Chave = [Chave CID Selecionada]
			RETURN CALCULATE(MAX(analitico_demografia_resumo[q1]), analitico_demografia_resumo[chave_alvo] = Chave)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 06 - Demografia
		lineageTag: 4e72a8cb-cd2b-4f2f-9818-a820d4535902

	measure 'Q3 Contraste Demográfico' =
			VAR Chave = [Chave CID Selecionada]
			RETURN CALCULATE(MAX(analitico_demografia_resumo[q3]), analitico_demografia_resumo[chave_alvo] = Chave)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 06 - Demografia
		lineageTag: 06b0d5b6-c68f-4892-837a-679da82d1338

	measure 'Municípios Válidos Demográfico' =
			VAR Chave = [Chave CID Selecionada]
			RETURN CALCULATE(MAX(analitico_demografia_resumo[municipios_validos]), analitico_demografia_resumo[chave_alvo] = Chave)
		formatString: 0
		displayFolder: 06 - Demografia
		lineageTag: a4c6acf2-ef5e-461f-a332-72930c956521

	measure '% Positivos Demográfico' =
			VAR Chave = [Chave CID Selecionada]
			RETURN DIVIDE(CALCULATE(MAX(analitico_demografia_resumo[percentual_positivo]), analitico_demografia_resumo[chave_alvo] = Chave), 100)
		formatString: 0.00%
		displayFolder: 06 - Demografia
		lineageTag: e63b19b1-86a0-43fb-8a65-d7fe28a23730

	measure '% Negativos Demográfico' =
			VAR Chave = [Chave CID Selecionada]
			RETURN DIVIDE(CALCULATE(MAX(analitico_demografia_resumo[percentual_negativo]), analitico_demografia_resumo[chave_alvo] = Chave), 100)
		formatString: 0.00%
		displayFolder: 06 - Demografia
		lineageTag: 6a706dd9-9df9-4213-badf-a1f79754e4a5

	measure 'Volume Internações Demográfico' =
			VAR Chave = [Chave CID Selecionada]
			RETURN CALCULATE(MAX(analitico_demografia_resumo[internacoes_total]), analitico_demografia_resumo[chave_alvo] = Chave)
		formatString: #,0
		displayFolder: 06 - Demografia
		lineageTag: ab34005c-d3c7-4b0d-a3ba-d3955f31f3c5

