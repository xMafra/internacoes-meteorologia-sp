				    Tipos = Table.TransformColumnTypes(Selecionado,{{"ano", Int64.Type},{"municipios_total", Int64.Type},{"municipios_elegiveis", Int64.Type},{"municipios_validos", Int64.Type},{"media_diferenca_relativa", type number},{"minimo", type number},{"maximo", type number},{"q1", type number},{"mediana_diferenca_relativa", type number},{"q3", type number},{"percentual_positivo", type number},{"percentual_negativo", type number}})
				in Tipos

