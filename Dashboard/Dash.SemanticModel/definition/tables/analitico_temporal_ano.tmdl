		lineageTag: 8954c109-9e4f-4099-b410-78543951ba0b

	measure 'Menor Contraste Observado Ano' = MAXX(TOPN(1, ALL(analitico_temporal_ano), analitico_temporal_ano[mediana_diferenca_relativa], ASC), analitico_temporal_ano[ano])
		formatString: 0
