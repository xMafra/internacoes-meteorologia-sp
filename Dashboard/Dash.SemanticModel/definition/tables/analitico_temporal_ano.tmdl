	partition analitico_temporal_ano = m
		mode: import
		source =
				let
				    Fonte = Folder.Files("C:\Users\Guilherme\Desktop\TCC\data\consumption\dashboard_analytics\temporal_ano"),
				    Arquivos = Table.SelectRows(Fonte, each [Extension] = ".parquet"),
				    Dados = Table.AddColumn(Arquivos, "Tabela", each Parquet.Document([Content])),
				    Expandido = Table.ExpandTableColumn(Dados, "Tabela", {"ano","municipios_total","municipios_elegiveis","municipios_validos","media_diferenca_relativa","minimo","maximo","q1","mediana_diferenca_relativa","q3","percentual_positivo","percentual_negativo"}),
