			RETURN DIVIDE(CALCULATE(MAX(analitico_lag_resumo[percentual_positivo]), REMOVEFILTERS(analitico_lag_resumo[alvo_analitico], analitico_lag_resumo[ordem_alvo]), analitico_lag_resumo[chave_alvo] = Alvo), 100)
