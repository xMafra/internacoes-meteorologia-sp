				    Tipos = Table.TransformColumnTypes(Selecionado,{{"chave_alvo", type text},{"alvo_analitico", type text},{"ordem_alvo", Int64.Type},{"defasagem", type text},{"ordem_defasagem", Int64.Type},{"municipios_validos", Int64.Type},{"q1", type number},{"mediana_diferenca_relativa", type number},{"q3", type number},{"percentual_positivo", type number},{"percentual_negativo", type number},{"mediana_media_frio", type number},{"mediana_media_quente", type number},{"internacoes_total", Int64.Type}})
