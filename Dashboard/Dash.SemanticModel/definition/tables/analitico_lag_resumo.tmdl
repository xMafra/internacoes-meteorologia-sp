	partition analitico_lag_resumo = m
		mode: import
		source =
				let
				    Fonte = Folder.Files("C:\Users\Guilherme\Desktop\TCC\data\consumption\dashboard_analytics\lag_resumo"),
				    Arquivos = Table.SelectRows(Fonte, each [Extension] = ".parquet"),
				    Dados = Table.AddColumn(Arquivos, "Tabela", each Parquet.Document([Content])),
				    Expandido = Table.ExpandTableColumn(Dados, "Tabela", {"chave_alvo","alvo_analitico","ordem_alvo","defasagem","ordem_defasagem","municipios_validos","q1","mediana_diferenca_relativa","q3","percentual_positivo","percentual_negativo","mediana_media_frio","mediana_media_quente","internacoes_total"}),
