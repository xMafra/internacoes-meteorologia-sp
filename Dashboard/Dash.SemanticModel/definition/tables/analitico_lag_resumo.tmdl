table analitico_lag_resumo
	lineageTag: 666d8aee-2907-47b7-8a08-f74f06f5dcbe

	measure 'Mediana Contraste Lag' =
			VAR Alvo = SELECTEDVALUE(analitico_lag_resumo[chave_alvo], "TOTAL")
			RETURN CALCULATE(MAX(analitico_lag_resumo[mediana_diferenca_relativa]), REMOVEFILTERS(analitico_lag_resumo[alvo_analitico], analitico_lag_resumo[ordem_alvo]), analitico_lag_resumo[chave_alvo] = Alvo)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 07 - Lags
