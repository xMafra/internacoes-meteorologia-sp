table analitico_contraste_municipio
	lineageTag: 2b889793-19a8-484a-b6f9-5bddbbb48ff5

	measure 'Mediana Contraste Intramunicipal' =
			MEDIANX(
				FILTER(analitico_contraste_municipio, analitico_contraste_municipio[contraste_relativo_valido] = 1),
				analitico_contraste_municipio[diferenca_relativa]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 03 - Intramunicipal
		lineageTag: c7e117a7-7275-4836-846a-935acfe4baac

	measure 'Q1 Contraste Intramunicipal' =
			PERCENTILEX.INC(
				FILTER(analitico_contraste_municipio, analitico_contraste_municipio[contraste_relativo_valido] = 1),
				analitico_contraste_municipio[diferenca_relativa], 0.25
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 03 - Intramunicipal
		lineageTag: 8fcb7124-bee7-4dcf-8401-7a7669cdc06a

	measure 'Q3 Contraste Intramunicipal' =
			PERCENTILEX.INC(
				FILTER(analitico_contraste_municipio, analitico_contraste_municipio[contraste_relativo_valido] = 1),
				analitico_contraste_municipio[diferenca_relativa], 0.75
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 03 - Intramunicipal
		lineageTag: 5adfa2ef-4ce8-470e-9321-d5ba4c3565aa

	measure 'Municípios Válidos' = SUM(analitico_contraste_municipio[contraste_relativo_valido])
		formatString: 0
		displayFolder: 03 - Intramunicipal
		lineageTag: 8c1589c5-0754-4226-ba1b-9ee870d50989

	measure '% Municípios Contraste Positivo' =
			DIVIDE(
				COUNTROWS(FILTER(analitico_contraste_municipio, analitico_contraste_municipio[contraste_relativo_valido] = 1 && analitico_contraste_municipio[diferenca_relativa] > 0)),
				[Municípios Válidos]
			)
		formatString: 0.00%
		displayFolder: 03 - Intramunicipal
		lineageTag: ea925a96-71f0-4a84-b842-f89c66b17627

	measure '% Municípios Contraste Negativo' =
			DIVIDE(
				COUNTROWS(FILTER(analitico_contraste_municipio, analitico_contraste_municipio[contraste_relativo_valido] = 1 && analitico_contraste_municipio[diferenca_relativa] < 0)),
				[Municípios Válidos]
			)
		formatString: 0.00%
		displayFolder: 03 - Intramunicipal
		lineageTag: 3be57578-982c-4f56-8dac-805d842de54e

	measure '% Municípios Acima +1%' = DIVIDE(COUNTROWS(FILTER(analitico_contraste_municipio, analitico_contraste_municipio[contraste_relativo_valido] = 1 && analitico_contraste_municipio[diferenca_relativa] > 0.01)), [Municípios Válidos])
		formatString: 0.00%
		displayFolder: 03 - Intramunicipal
		lineageTag: 7aa280e9-f594-4ac9-b716-55e9c6e2e2ca

	measure '% Municípios Aprox. Zero' = DIVIDE(COUNTROWS(FILTER(analitico_contraste_municipio, analitico_contraste_municipio[contraste_relativo_valido] = 1 && ABS(analitico_contraste_municipio[diferenca_relativa]) <= 0.01)), [Municípios Válidos])
		formatString: 0.00%
		displayFolder: 03 - Intramunicipal
		lineageTag: 71064781-2ce9-4670-b56b-06c7ec4daae6

	measure '% Municípios Abaixo -1%' = DIVIDE(COUNTROWS(FILTER(analitico_contraste_municipio, analitico_contraste_municipio[contraste_relativo_valido] = 1 && analitico_contraste_municipio[diferenca_relativa] < -0.01)), [Municípios Válidos])
		formatString: 0.00%
		displayFolder: 03 - Intramunicipal
		lineageTag: 18edf575-7275-4643-a031-ee374fe79c11

	measure '% Municípios por Classe' =
			DIVIDE(
				[Municípios Válidos],
				CALCULATE([Municípios Válidos], REMOVEFILTERS(analitico_contraste_municipio[Classe Contraste]))
			)
		formatString: 0.00%
		displayFolder: 03 - Intramunicipal
		lineageTag: 67c798c8-5e0b-4895-bcf6-31f2dddd4470

	measure 'Contraste Relativo Município' = SELECTEDVALUE(analitico_contraste_municipio[diferenca_relativa])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 08 - Territorial
		lineageTag: fbe518d2-f4b3-4ba6-b144-c70a83905bf5

	measure 'Média Frio Município' = SELECTEDVALUE(analitico_contraste_municipio[media_frio_municipio])
		formatString: 0.00
		displayFolder: 08 - Territorial
		lineageTag: 45128e04-bd28-4a9c-9857-e85101e60acc

	measure 'Média Quente Município' = SELECTEDVALUE(analitico_contraste_municipio[media_quente_municipio])
		formatString: 0.00
		displayFolder: 08 - Territorial
		lineageTag: ba715985-97ef-4677-aea7-9ede921d4a92

	measure 'Diferença Absoluta Município' = SELECTEDVALUE(analitico_contraste_municipio[diferenca_absoluta])
		formatString: 0.00
		displayFolder: 08 - Territorial
		lineageTag: 02ded256-a0f1-47cf-92f2-d33e9e21803a

	measure 'Dias Frios Município' = SELECTEDVALUE(analitico_contraste_municipio[dias_frios])
		formatString: 0
		displayFolder: 08 - Territorial
		lineageTag: 1c7f83eb-301b-4658-8b9e-9a2a9fcf6e57

	measure 'Dias Quentes Município' = SELECTEDVALUE(analitico_contraste_municipio[dias_quentes])
		formatString: 0
		displayFolder: 08 - Territorial
		lineageTag: 42aff1e3-f7fb-4b89-aefc-2b063dd9ab8d

	measure 'Volume Internações Município' = SELECTEDVALUE(analitico_contraste_municipio[internacoes_total])
		formatString: 0
		displayFolder: 08 - Territorial
		lineageTag: ec1cfa5a-49db-44c4-95cd-cf052693ad7c

