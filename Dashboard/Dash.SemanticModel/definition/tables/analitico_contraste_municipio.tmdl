		summarizeBy: sum
		sourceColumn: contraste_relativo_valido

	column 'Classe Contraste' =
			SWITCH(
				TRUE(),
				analitico_contraste_municipio[contraste_relativo_valido] <> 1, BLANK(),
				analitico_contraste_municipio[diferenca_relativa] > 0.01, "> +1%",
				analitico_contraste_municipio[diferenca_relativa] < -0.01, "< -1%",
				"Entre -1% e +1%"
			)
		dataType: string
		lineageTag: b13f21fc-ca64-4d48-94aa-a5938d7668bb
		summarizeBy: none
		sortByColumn: 'Ordem Classe Contraste'

	column 'Ordem Classe Contraste' =
			SWITCH(
				TRUE(),
				analitico_contraste_municipio[contraste_relativo_valido] <> 1, BLANK(),
				analitico_contraste_municipio[diferenca_relativa] < -0.01, 1,
				analitico_contraste_municipio[diferenca_relativa] > 0.01, 3,
				2
			)
		dataType: int64
		formatString: 0
		lineageTag: 4043a6c6-abdb-4c65-8c89-a7aa2949e566
		summarizeBy: none

