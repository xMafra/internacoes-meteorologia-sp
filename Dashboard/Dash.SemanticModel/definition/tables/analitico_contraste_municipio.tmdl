		dataCategory: Longitude
		summarizeBy: none
		sourceColumn: longitude_municipio

	partition analitico_contraste_municipio = m
		mode: import
		source =
				let
				    Fonte = Folder.Files("C:\Users\Guilherme\Desktop\TCC\data\consumption\dashboard_analytics\contraste_municipio"),
				    Arquivos = Table.SelectRows(Fonte, each [Extension] = ".parquet"),
				    Dados = Table.AddColumn(Arquivos, "Tabela", each Parquet.Document([Content])),
				    Expandido = Table.ExpandTableColumn(Dados, "Tabela", {"codigo_municipio","internacoes_frio","internacoes_quente","dias_frios","dias_quentes","internacoes_total","municipio_dias_total","media_frio_municipio","media_quente_municipio","diferenca_absoluta","diferenca_relativa","elegivel_amostra","contraste_relativo_valido","nome_municipio","latitude_municipio","longitude_municipio"}),
				    Selecionado = Table.SelectColumns(Expandido,{"codigo_municipio","internacoes_frio","internacoes_quente","dias_frios","dias_quentes","internacoes_total","municipio_dias_total","media_frio_municipio","media_quente_municipio","diferenca_absoluta","diferenca_relativa","elegivel_amostra","contraste_relativo_valido","nome_municipio","latitude_municipio","longitude_municipio"}),
				    Tipos = Table.TransformColumnTypes(Selecionado,{{"codigo_municipio", type text},{"internacoes_frio", Int64.Type},{"internacoes_quente", Int64.Type},{"dias_frios", Int64.Type},{"dias_quentes", Int64.Type},{"internacoes_total", Int64.Type},{"municipio_dias_total", Int64.Type},{"media_frio_municipio", type number},{"media_quente_municipio", type number},{"diferenca_absoluta", type number},{"diferenca_relativa", type number},{"elegivel_amostra", Int64.Type},{"contraste_relativo_valido", Int64.Type},{"nome_municipio", type text},{"latitude_municipio", type number},{"longitude_municipio", type number}})
				in Tipos

